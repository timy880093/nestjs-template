{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/new-project-template/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "watchAssets": true,
    "assets": [
      "third-party/mail/templates/**/*",
      "modules/gift-card/templates/**/*"
    ],
    "tsConfigPath": "apps/new-project-template/tsconfig.app.json"
  },
  "projects": {
    "postgres": {
      "type": "library",
      "root": "libs/postgres",
      "entryFile": "index",
      "sourceRoot": "libs/postgres/src",
      "compilerOptions": {
        "tsConfigPath": "libs/postgres/tsconfig.lib.json"
      }
    },
    "new-project-template": {
      "type": "application",
      "root": "apps/new-project-template",
      "entryFile": "main",
      "sourceRoot": "apps/new-project-template/src",
      "compilerOptions": {
        "tsConfigPath": "apps/new-project-template/tsconfig.app.json"
      }
    },
    "invoice": {
      "type": "library",
      "root": "libs/invoice",
      "entryFile": "index",
      "sourceRoot": "libs/invoice/src",
      "compilerOptions": {
        "tsConfigPath": "libs/invoice/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "mail": {
      "type": "library",
      "root": "libs/mail",
      "entryFile": "index",
      "sourceRoot": "libs/mail/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mail/tsconfig.lib.json"
      }
    },
    "payment": {
      "type": "library",
      "root": "libs/payment",
      "entryFile": "index",
      "sourceRoot": "libs/payment/src",
      "compilerOptions": {
        "tsConfigPath": "libs/payment/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "s3": {
      "type": "library",
      "root": "libs/s3",
      "entryFile": "index",
      "sourceRoot": "libs/s3/src",
      "compilerOptions": {
        "tsConfigPath": "libs/s3/tsconfig.lib.json"
      }
    },
    "sms": {
      "type": "library",
      "root": "libs/sms",
      "entryFile": "index",
      "sourceRoot": "libs/sms/src",
      "compilerOptions": {
        "tsConfigPath": "libs/sms/tsconfig.lib.json"
      }
    },
    "mq": {
      "type": "library",
      "root": "libs/mq",
      "entryFile": "index",
      "sourceRoot": "libs/mq/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mq/tsconfig.lib.json"
      }
    }
  },
  "monorepo": true,
  "root": "apps/new-project-template"
}